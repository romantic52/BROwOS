# Generate two DIFFERENT secrets locally, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# These are SERVER settings. Never put a token in VITE_* variables or commit .env.
BROWOS_ACCESS_TOKEN=
BROWOS_EGRESS_PROXY_TOKEN=
BROWOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BROWOS_PUBLIC_ORIGIN=http://localhost:8080
BROWOS_HOST=127.0.0.1
BROWOS_PORT=3001
# Public static frontend build path only (not a secret):
VITE_BASE_PATH=./
